<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.libraryms.mapper.SysUserMapper">

  <resultMap id="BaseMap" type="com.example.libraryms.entity.SysUser">
    <id column="id" property="id"/>
    <result column="username" property="username"/>
    <result column="password_hash" property="passwordHash"/>
    <result column="role" property="role"/>
    <result column="enabled" property="enabled"/>
    <result column="created_at" property="createdAt"/>
    <result column="updated_at" property="updatedAt"/>
  </resultMap>

  <select id="findByUsername" resultMap="BaseMap">
    select * from sys_user where username = #{username} limit 1
  </select>

  <select id="findById" resultMap="BaseMap">
    select * from sys_user where id = #{id} limit 1
  </select>

  <select id="countAll" resultType="long">
    select count(1) from sys_user
  </select>

  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    insert into sys_user (username, password_hash, role, enabled)
    values (#{username}, #{passwordHash}, #{role}, #{enabled})
  </insert>

  <update id="update">
    update sys_user
    set
      username = #{username},
      password_hash = #{passwordHash},
      role = #{role},
      enabled = #{enabled}
    where id = #{id}
  </update>

  <delete id="deleteById">
    delete from sys_user where id = #{id}
  </delete>

  <sql id="kwWhere">
    <where>
      <if test="keyword != null and keyword != ''">
        and (username like concat('%', #{keyword}, '%') or role like concat('%', #{keyword}, '%'))
      </if>
    </where>
  </sql>

  <select id="count" resultType="long">
    select count(1) from sys_user
    <include refid="kwWhere"/>
  </select>

  <select id="page" resultMap="BaseMap">
    select * from sys_user
    <include refid="kwWhere"/>
    order by id desc
    limit #{limit} offset #{offset}
  </select>

</mapper>

